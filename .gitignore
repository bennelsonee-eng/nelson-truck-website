# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.eggs/

# --- Node / Vite ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Env & secrets ---
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs & runtime ---
*.log
logs/
pids/
*.pid

# --- Test coverage ---
.coverage
htmlcov/
.pytest_cache/

# --- Database backups (local only) ---
*.sql.gz
*.dump
local_backups/
# /backups/ dir holds large .dump + .tar.gz snapshots (DB + static
# images).  Keep the README in git but ignore the data files.
/backups/*.dump
/backups/*.tar.gz
/backups/*.sql.gz

# --- Docker volumes (local only) ---
typesense_data/
postgres_data/

# --- Migration artifacts ---
app/backend/migrations/versions/__pycache__/

# --- Discovery artifacts (large screenshots) ---
discovery/screenshots/*.png
# (keep .md notes, exclude large binary screenshots)

# --- Imported data files (large; sensitive customer data) ---
# WSM exports, PACE imports, etc. should never be committed
data/
*.csv.gz
imported_data/
# Specific large files
product-*.csv
category-*.csv

# --- Office lock files (created when Word/LibreOffice opens a docx) ---
.~lock.*#
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls

# --- Misc ---
.cache/
tmp/
*.bak
nul
wan_test_output/

# --- Manufacturer scrape dumps (raw, regeneratable) ---
# Tens of MB per brand of HTML + cross-page nav images.  The valuable
# artefacts get extracted into snow-plows/skus/<SKU>/ which IS tracked.
# Re-run app/scripts/scrape_*_full.py to rebuild the local cache.
app/backend/static/snow-plows/manufacturer_data/

# --- Truck render outputs (large; regenerable via FLUX pipeline; backed up to Backblaze) ---
# Existing tracked PNGs stay; new renders skip git and live in Backblaze.
# Use `git add -f` to intentionally track a specific render.
app/backend/static/trucks/renders_flux_dev/
app/backend/static/trucks/renders_by_angle/
app/backend/static/trucks/renders_curated/
app/backend/static/_auto_composites_truck_match/

# --- Western doc-library / posters: PDFs are large + regeneratable ---
# 739 MB of mount-kit install instructions + parts lists across 14 makes.
# JSON indexes (_index.json, _master_index.json, _summary.md) ARE tracked
# so downstream code can resolve mount_kit_sku → URL without local PDFs.
# Re-run app/scripts/scrape_western_doc_library.py --all-makes-mount-kits
# (or scrape_western_posters.py) to rebuild the local cache.
refs/western_doc_library/**/*.pdf
refs/western_doc_library/**/_debug/
refs/western_posters/*.pdf
refs/western_posters/_debug/

# Backups of category tile images before resize_category_images.py downscaled them
app/backend/static/category-images/_originals/

# Local catalog PDFs / temp review artifacts (not for the repo)
*_FROM_CACHE.pdf
WSTRN_Snowplow_Brochure_*.pdf
Liftmoore availability.jpg
temp_pdf_review/
refs/_candidates/
.claude/worktrees/
refs/**/*.pdf
refs/**/*_app_guide.json

# Local DB reclassification backups (generated by reclassify_van_accessories.py)
backups/van_reclassify/

backups/kargomaster_reclassify/

# Raw PACE/AAM vendor data dumps — never commit (large binaries)
PACE_downloads/

# --- Nelson deploy artifacts (symlinks to shared/titan data) ---
app/data/
app/backend/static/
*.log
*.err
*.out

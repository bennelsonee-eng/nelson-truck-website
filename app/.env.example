# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# --- Database ---
# Note: port 5433 (not 5432) so Titan Postgres can run alongside Nelson ERP's native Postgres
DATABASE_URL=postgresql+asyncpg://postgres:titan2026@localhost:5433/titan_web

# --- App ---
APP_NAME="Titan Truck Equipment"
DEBUG=true
ENVIRONMENT=development

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
REQUIRE_AUTH=true

# --- Search (Typesense) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=titan_search_dev_key

# --- Source data sync (Titan MySQL) ---
TITAN_MYSQL_HOST=
TITAN_MYSQL_PORT=3306
TITAN_MYSQL_USER=
TITAN_MYSQL_PASS=
TITAN_MYSQL_DB=
TITAN_INVENTORY_SYNC_MINUTES=15
TITAN_PRICING_SYNC_HOUR=1            # 1am PST nightly bulk

# --- FACS / IMS315 order push ---
FACS_FTP_HOST=
FACS_FTP_PORT=21
FACS_FTP_USER=
FACS_FTP_PASS=
FACS_DROPBOX_PATH=/titan_orders
FACS_PICKUP_LAG_ALERT_MINUTES=30     # alert if FACS hasn't grabbed a file in N min

# --- Authorize.net (payment) ---
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_PUBLIC_CLIENT_KEY=
AUTHNET_ENVIRONMENT=sandbox          # sandbox or production

# --- Email (Postmark / SendGrid / Mailchimp — pick one) ---
EMAIL_PROVIDER=postmark              # postmark / sendgrid / mailchimp
EMAIL_API_KEY=
EMAIL_FROM=sales@titantruck.com

# --- Cloudflare (for DNS / cache management API) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- PACE / AAM Group catalog ---
PACE_API_BASE=
PACE_MEMBER_CODE=
PACE_API_KEY=

# --- Anthropic (Phase 2 AI features; not used in Phase 1) ---
ANTHROPIC_API_KEY=

# --- Public URL (for emails, callback links, etc.) ---
PUBLIC_URL=http://localhost:5173
